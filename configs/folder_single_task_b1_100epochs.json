  "run": {
    "seed": 42,
    "epochs": 100,
    "device": "cuda",
    "amp": true,
    "amp_dtype": "bf16",
    "channels_last": true,
    "allow_tf32": true,
    "cudnn_benchmark": true,
    "gradient_accumulation_steps": 4,
    "early_stopping_patience": 15,
    "early_stopping_metric": "foreground_mean_dice",
