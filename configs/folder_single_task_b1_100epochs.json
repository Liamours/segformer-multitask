{
  "model": {
    "variant": "mit_b1",
    "task_mode": "single_task",
    "num_classes": 3,
    "pretrained_path": null,
    "pretrained_hf_name": "nvidia/mit-b1",
    "freeze_backbone": false
  },
  "data": {
    "dataset_name": "folder",
    "root_dir": "C:/rifqi/research-wbbs-multitask_uq/dataset/segformer/bs80k_lesion",
    "train_split": "train.txt",
    "val_split": "val.txt",
    "test_split": "test.txt",
    "image_dir": "images",
    "mask_dir": "masks",
    "image_suffix": ".png",
    "mask_suffix": ".png",
    "image_size": [1024, 512],
    "batch_size": 1,
    "eval_batch_size": 1,
    "train_num_workers": 0,
    "val_num_workers": 0,
    "pin_memory": false,
    "persistent_workers": false,
    "paired_views": true,
    "anterior_suffix": "_0000",
