  "optimizer": {
    "name": "adamw",
    "learning_rate_backbone": 0.00001,
    "learning_rate_head": 0.0001,
    "betas": [0.9, 0.999],
    "weight_decay": 0.01
  },
  "scheduler": {
    "name": "poly",
    "warmup_iters": 1500,
    "warmup_ratio": 0.000001,
    "poly_power": 1.0,
