{
  "model": {
    "variant": "mit_b2",
    "task_mode": "single_task",
    "num_classes": 3
  },
  "data": {
    "dataset_name": "folder",
    "root_dir": "C:/rifqi/research-wbbs-multitask_uq/dataset/segformer/bs80k_lesion",
    "train_split": "train.txt",
    "val_split": "val.txt",
    "test_split": "test.txt",
    "image_dir": "images",
    "mask_dir": "masks",
    "image_suffix": ".png",
    "mask_suffix": ".png",
