{
  "model": {
    "variant": "mit_b2",
    "task_mode": "single_task",
    "num_classes": 3,
    "pretrained_path": null,
    "pretrained_hf_name": "nvidia/mit-b2",
    "freeze_backbone": false
  },
  "data": {
    "dataset_name": "folder",
    "root_dir": "C:/rifqi/research-wbbs-multitask_uq/dataset/segformer/bs80k_lesion",
    "train_split": "train.txt",
    "val_split": "val.txt",
    "test_split": "test.txt",
    "image_dir": "images",
    "mask_dir": "masks",
    "image_suffix": ".png",
    "mask_suffix": ".png",
    "image_size": [
      1024,
      512
    ],
    "batch_size": 4,
    "eval_batch_size": 4,
    "train_num_workers": 6,
    "val_num_workers": 4,
    "paired_views": true,
    "anterior_suffix": "_0000",
    "posterior_suffix": "_0001",
    "normalize_mean": [
      0.485,
      0.456,
      0.406
    ],
    "normalize_std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate_backbone": 1e-05,
    "learning_rate_head": 0.0001,
    "betas": [
      0.9,
      0.999
    ],
    "weight_decay": 0.01
  },
  "scheduler": {
    "warmup_iters": 20
  },
  "loss": {
    "name": "dice_ce",
    "ce_weight": 1.0,
    "dice_weight": 1.0,
    "task_a_weight": 1.0,
    "task_b_weight": 1.0,
    "ignore_index": 255
  },
  "logging": {
    "output_dir": "C:/rifqi/research-wbbs-multitask_uq/weights/single_task_pretrained_smoke",
    "run_name": "single_task_pretrained_smoke",
    "save_checkpoints": true,
    "save_epoch_checkpoints": false,
    "checkpoint_metric": "foreground_mean_dice",
    "checkpoint_mode": "max",
    "log_every_n_steps": 50
  },
  "run": {
    "epochs": 2,
    "device": "cuda",
    "max_train_batches": 200,
    "max_eval_batches": 20,
    "allow_limited_batches": true,
    "amp": true,
    "amp_dtype": "bf16",
    "channels_last": true,
    "allow_tf32": true,
    "cudnn_benchmark": true,
    "gradient_accumulation_steps": 1
  }
}
